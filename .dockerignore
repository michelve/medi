# Keep the Docker build context small and fast for Unraid pulls (docs/.tasks/50
# §Scaling). `backend/` (build stage) + `client/` (web stage, Task 80) + `docker/` are
# needed; a clean `yarn install` runs in the web stage, so ship source but not the huge
# node_modules / target trees.
**/target
**/node_modules
# NOTE: `client/` is intentionally NOT ignored — the web stage builds @medi/web from it.
client/apps/*/dist
# Windows dev loop bind-mount data (docker/compose.dev.yml, docs/.tasks/92) — never build context.
docker/devdata
docs
unraid-templates
.git
.github
**/*.md
!backend/**/*.sql
.gitignore
.gitattributes
