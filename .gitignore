# Rust
/backend/target/
**/*.rs.bk

# Node / Yarn (client monorepo)
node_modules/
.expo/
dist/
*.tsbuildinfo

# Expo CNG: native projects are generated by `expo prebuild`, never committed
/client/apps/*/ios/
/client/apps/*/android/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# medi runtime data (/config mount): db, WAL, generated assets, logs
/config/
*.db
*.db-wal
*.db-shm

# OS / editor
.DS_Store
Thumbs.db
